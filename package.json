{
  "name": "delta-uno",
  "version": "0.13.0",
  "private": true,
  "description": "Juego de naves en 3D para teléfono, sobre un planeta esférico.",
  "scripts": {
    "dev": "vite",
    "dev:telefono": "vite --host",
    "build": "vite build && node scripts/artifact.mjs dist",
    "build:test": "vite build --mode test && node scripts/artifact.mjs dist-test",
    "android:preparar": "vite build && cap sync android",
    "preview": "vite preview",
    "test": "node tests/run.js",
    "medir:punteria": "node tests/herramientas/medir-punteria.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "playwright": "1.63.0",
    "qrcode": "^1.5.4",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4"
  }
}
